# Backend environment variables

# JWT
JWT_SECRET=change_me_dev_secret

# Twilio (Free Trial)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15005550006

# App name (optional)
APP_NAME=Electronics Repair

# Redis (for caching, rate limiting, and BullMQ queues)
# If REDIS_URL is provided, it takes precedence over host/port/db/password
# Example: redis://:password@localhost:6379/0
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# API response caching (seconds)
API_CACHE_TTL=30

# Notifications: use background queue (BullMQ). Set to 'false' to disable.
NOTIFICATIONS_USE_QUEUE=true
